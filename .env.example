# The settings this project reads from .env (copy this file to .env and fill
# in the values; .env is never committed). The GitHub update reads the same
# names from the repository's Actions secrets instead.

# Sportmonks API, for src/fetch/download_season.py.
SPORTMONKS_API_TOKEN=

# TFF fantasy login, for src/fetch/export_tff_browser.py. Optional: without
# them you sign in yourself in the browser window it opens. The GitHub update
# reads the same names from Actions secrets to export TFF about once a day.
TFF_FANTASY_EMAIL=
TFF_FANTASY_PASSWORD=

# Cloudflare R2, for src/sync_data.py. R2_ACCOUNT_ID is the Cloudflare Account ID.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fantezianaliz-data

# Optional: uploading the site from this computer without wrangler's browser login.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Optional: the Cloudflare D1 database the Ana Sayfa chat reads online, for
# src/chat/sync_chat_d1.py. CLOUDFLARE_API_TOKEN then needs D1 Edit as well.
CHAT_D1_DATABASE_ID=

# API keys for the Anasayfa chatbot (docs/chatbot/04-connect-the-ai.md). Never commit them.
# Anthropic (Claude): console.anthropic.com -> API Keys.
ANTHROPIC_API_KEY=
# OpenAI (ChatGPT): platform.openai.com -> API keys.
OPENAI_API_KEY=
